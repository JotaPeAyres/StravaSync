# Credenciais do app registrado no Strava — https://www.strava.com/settings/api
# São da APLICAÇÃO, compartilhadas por todos os participantes da pesquisa.
# O refresh_token é de cada participante e fica em `corredores.toml`.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Cadastro dos participantes (um bloco [[corredor]] por corredor).
# Caminhos relativos partem da raiz do projeto, não do diretório de execução.
CORREDORES_PATH=./corredores.toml

# Modelo base copiado por participante, e o banco com os dados por atividade.
TEMPLATE_PATH=./Cópia de Planilha_carga_corrida.xlsx
DATABASE_PATH=./data/stravasync.db

# Vazão do Strava. O limite é da APLICAÇÃO (100 req/15min, 1000/dia) e é
# dividido por todos os participantes — a cada corredor a mais, sobra menos.
# Timeout de cada requisição HTTP, em segundos (mínimo 1).
STRAVA_TIMEOUT_S=20
# Pausa mínima entre chamadas, em segundos. É o botão para desacelerar quando a
# pesquisa cresce: 1s espaça ~100 requisições ao longo de 100s.
STRAVA_PAUSA_ENTRE_CHAMADAS_S=1
# Quanto da janela de 15 minutos fica de folga, para que uma inscrição manual
# (`python -m src.inscricao trocar ...`) não esbarre no teto durante a coleta.
STRAVA_RESERVA_DE_VAZAO=10

# Logging: CRITICAL | ERROR | WARNING | INFO | DEBUG
LOG_LEVEL=INFO
# Arquivo de log rotativo; deixe vazio (LOG_FILE=) para registrar só no console.
LOG_FILE=./data/stravasync.log
