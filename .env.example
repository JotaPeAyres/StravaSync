# Credenciais do Strava (um atleta) — https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=

# Planilha do corredor (cópia do template) e o template base.
# Caminhos relativos partem da raiz do projeto, não do diretório de execução.
EXCEL_PATH=./data/corredor.xlsx
TEMPLATE_PATH=./data/template.xlsx

# Data da primeira coleta de dados do corredor (YYYY-MM-DD) = "Dia 1" da planilha.
# É o marco zero do histórico: corridas anteriores a esta data ficam de fora.
# Define o mapeamento data → linha; mudar depois desalinha tudo que já foi gravado.
START_DATE=2026-01-01

# Data de corte: primeiro dia em que o app passa a escrever na planilha.
# Deixe vazio (ou igual a START_DATE) para um corredor novo — o app assume desde
# o Dia 1. Numa planilha já preenchida à mão, aponte para o dia em que o app
# assume: tudo antes disso é território do corredor e nunca é sobrescrito.
CUTOVER_DATE=

# Logging: CRITICAL | ERROR | WARNING | INFO | DEBUG
LOG_LEVEL=INFO
# Arquivo de log rotativo; deixe vazio (LOG_FILE=) para registrar só no console.
LOG_FILE=./data/stravasync.log
